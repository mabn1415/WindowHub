{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowHub",
  "version": "0.1.0",
  "identifier": "local.windowhub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WindowHub",
        "width": 520,
        "height": 270,
        "minWidth": 440,
        "minHeight": 220,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "center": true,
        "shadow": true,
        "backgroundColor": "#00000000",
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Keyboard-first window layouts",
    "category": "Utility",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
